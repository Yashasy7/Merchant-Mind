# ==============================================================================
# Paytm MerchantMind — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# NEVER commit the actual .env file or real secrets to Git.

# --- Application Settings ---
APP_NAME="Paytm MerchantMind API"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# --- CORS Settings ---
# Allowed origins for frontend (e.g. Vite dev server)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# --- Database Settings (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local fallback without Postgres: sqlite:///./merchantmind.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merchantmind
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Demo & Synthetic Data Settings ---
# Fixed ID for the demo merchant (e.g. Sharma General Store)
DEMO_MERCHANT_ID=demo-merchant-001
# Random seed for reproducible synthetic data generation
SEED_RANDOM_SEED=42
# Data storage mode: postgres | memory
DATA_MODE=postgres

# --- AI & LLM Settings ---
# Provider options: gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your-gemini-api-key-here

# --- Cognee Cloud — AI Memory Layer ---
# Obtain from your Cognee Cloud dashboard (https://app.cognee.ai)
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_TENANT_ID=
COGNEE_USER_ID=

# --- n8n — Campaign Delivery Automation ---
# URL of the n8n webhook trigger (must point to your configured campaign workflow)
N8N_WEBHOOK_URL=
# Optional: only required if your n8n webhook is configured with secret-based auth
N8N_WEBHOOK_SECRET=
