# ==============================================================================
# Paytm MerchantMind — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# NEVER commit the actual .env file or real secrets to Git.

# --- Application Settings ---
APP_NAME="Paytm MerchantMind API"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# --- CORS Settings ---
# Allowed origins for frontend (e.g. Vite dev server)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# --- Database Settings (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local fallback without Postgres: sqlite:///./merchantmind.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merchantmind
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Demo & Synthetic Data Settings ---
# Fixed ID for the demo merchant (e.g. Sharma General Store)
DEMO_MERCHANT_ID=demo-merchant-001
# Random seed for reproducible synthetic data generation
SEED_RANDOM_SEED=42
# Data storage mode: postgres | memory
DATA_MODE=postgres

# --- AI & LLM Settings (Future Module Placeholder) ---
# Provider options: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
